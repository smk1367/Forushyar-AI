# Copy to .env and set unique secrets. Do not commit .env.
APP_ENV=development
POSTGRES_DB=forushyar
POSTGRES_USER=forushyar
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://forushyar:CHANGE_ME@db:5432/forushyar
REDIS_URL=redis://redis:6379/0
API_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET
SESSION_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Grandstream UCM6202 integration (disabled until configured)
UCM_ENABLED=false
UCM_API_URL=https://PBX_IP:8089/api
UCM_API_USERNAME=
UCM_API_PASSWORD=
UCM_CDR_URL=https://PBX_IP:8443/cdrapi
UCM_RECORDING_URL=https://PBX_IP:8443/recapi
UCM_CDR_USERNAME=
UCM_CDR_PASSWORD=
UCM_VERIFY_TLS=true
UCM_SYNC_INTERVAL_SECONDS=60
UCM_LIVE_POLL_SECONDS=2
UCM_CDR_PAGE_SIZE=500
UCM_CDR_MAX_PAGES=20

# Optional HTTP/HTTPS real-time CDR callback
UCM_WEBHOOK_USERNAME=
UCM_WEBHOOK_PASSWORD=

# Optional TCP receiver; add the trusted PBX IP before enabling.
UCM_TCP_LISTENER_ENABLED=false
UCM_TCP_HOST=0.0.0.0
UCM_TCP_PORT=10000
UCM_TCP_ALLOWED_IPS=[]
UCM_TCP_BIND_IP=127.0.0.1
UCM_TCP_HOST_PORT=10000
